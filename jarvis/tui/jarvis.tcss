/* Red on black: text #C2241B, active #FF3B30, idle and borders #6B1512. */
Screen { background: black; color: #C2241B; }

#header { height: 3; border: heavy #6B1512; padding: 0 1; }
#title { width: 1fr; color: #FF3B30; text-style: bold; }
#link { width: auto; }

.panels { height: 1fr; }
.panel { height: 1fr; border: heavy #6B1512; border-title-color: #C2241B; border-title-style: bold; padding: 0 1; overflow: hidden; }
#voice, #queue { width: 32; }
#agents, #memory { width: 1fr; }

#notice { height: 1fr; border: heavy #FF3B30; padding: 1 2; color: #FF3B30; text-style: bold; display: none; }

#question { height: auto; padding: 0 1; display: none; }

#skills { height: auto; max-height: 8; background: black; border: heavy #FF3B30; display: none; }
#skills > .option-list--option-highlighted { background: #6B1512; color: black; }

#ask { height: 3; background: black; color: #C2241B; border: heavy #6B1512; }
#ask:focus { border: heavy #FF3B30; }

#footer { height: 1; padding: 0 1; color: #C2241B; }
